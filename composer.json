{
    "name": "sunaoka/phpunit-laravel-localization",
    "description": "Laravel Localization PHPUnit testing",
    "keywords": ["phpunit", "laravel", "localization", "testing"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sunaoka",
            "email": "sunaoka@pocari.org"
        }
    ],
    "require": {
        "php": "^7.2 || ^8.0",
        "laravel/framework": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "nikic/php-parser": "^4.0 || ^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^4.0 || ^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0 || ^2.1",
        "phpstan/phpstan-strict-rules": "^1.0 || ^2.0"
    },
    "suggest": {
        "laravel/pint": "PHP code style fixer for minimalists"
    },
    "autoload": {
        "psr-4": {
            "Sunaoka\\PHPUnit\\Laravel\\Localization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit",
        "ci": [
            "@ci:pint",
            "@ci:phpstan"
        ],
        "ci:pint": "vendor/bin/pint",
        "ci:phpstan": "vendor/bin/phpstan analyse --memory-limit=-1"
    },
    "config": {
        "audit": {
            "ignore": [
                "laravel/framework",
                "league/commonmark",
                "symfony/http-foundation",
                "symfony/mailer",
                "symfony/mime",
                "symfony/process",
                "symfony/routing"
            ]
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
