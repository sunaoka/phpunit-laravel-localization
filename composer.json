{
    "name": "sunaoka/phpunit-laravel-localization",
    "description": "Laravel Localization PHPUnit testing",
    "keywords": ["phpunit", "laravel", "localization", "testing"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sunaoka",
            "email": "sunaoka@pocari.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^6.47 || ^7.55 || ^8.36 || ^9.14 || ^10.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.1"
    },
    "autoload": {
        "psr-4": {
            "Sunaoka\\PHPUnit\\Laravel\\Localization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit",
        "ci": [
            "@ci:pint",
            "@ci:phpstan"
        ],
        "ci:pint": "vendor/bin/pint",
        "ci:phpstan": "vendor/bin/phpstan analyse --memory-limit=-1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
